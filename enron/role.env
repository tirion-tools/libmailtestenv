# Host side of the enron role, sourced by testenv.sh. The CMU tarball is pinned by sha256: it is downloaded from CMU
# and verified, never taken from anywhere else (no copy is committed). It is mounted read-only; the container converts
# it once into the pristine snapshot.
ENRON_URL=https://www.cs.cmu.edu/~enron/enron_mail_20150507.tar.gz
ENRON_SHA256=b3da1b3fe0369ec3140bb4fbce94702c33b7da810ec15d718b3fadf5cd748ca7
ENRON_TARBALL=$STATE/enron/dl/enron_mail_20150507.tar.gz

enron_docker_args() {
  mkdir -p "$STATE/enron/dl"
  if [[ ! -f $ENRON_TARBALL ]] || ! echo "$ENRON_SHA256  $ENRON_TARBALL" | sha256sum -c --quiet --status; then
    curl --fail --location --retry 3 --silent --show-error -o "$ENRON_TARBALL.part" "$ENRON_URL" >&2
    echo "$ENRON_SHA256  $ENRON_TARBALL.part" | sha256sum -c --quiet --status || die "Enron tarball sha256 mismatch"
    mv "$ENRON_TARBALL.part" "$ENRON_TARBALL"
  fi
  [[ -d $STATE/mail/private ]] || die "enron needs the mail role's TLS certificate: testenv.sh up mail first"
  echo "-v $ENRON_TARBALL:/dl/enron.tar.gz:ro -v $STATE/mail/private:/tls:ro -e ENRON_SHA256=$ENRON_SHA256"
}
