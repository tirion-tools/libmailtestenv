# Postfix submission for the Enron users (testenv enron role): the account-setup flow needs an SMTP server that
# signs in the same users as IMAP. SASL through enron's Dovecot (passwd-file, password "pass"); TLS with the mail
# role's CA (enron.mailtestenv.test + mail.mailtestenv.test, /etc/postfix/pki/enron.pem built from /tls by start.sh).
# Accepted mail is discarded (logged in /var/log/postfix.log): nothing ever leaves the container.
compatibility_level = 3.11
myhostname = enron.mailtestenv.test
mydomain = mailtestenv.test
myorigin = $mydomain
mydestination =
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
default_transport = discard:mailtestenv enron discards submitted mail
relay_transport = $default_transport
local_transport = $default_transport
maillog_file = /var/log/postfix.log
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP mailtestenv-enron
alias_maps =
alias_database =
smtpd_tls_chain_files = /etc/postfix/pki/enron.pem
smtpd_tls_loglevel = 1
smtp_tls_security_level = none
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_relay_restrictions = permit_sasl_authenticated, reject
smtpd_recipient_restrictions = permit_sasl_authenticated, reject
