compatibility_level = 3.11
myhostname = mail.mailtestenv.test
mydomain = mailtestenv.test
myorigin = $mydomain
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
# Never deliver anywhere but the local test domain.
default_transport = error:mailtestenv delivers to mailtestenv.test only
relay_transport = error:mailtestenv delivers to mailtestenv.test only
maillog_file = /var/log/postfix.log
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP mailtestenv
virtual_mailbox_domains = mailtestenv.test
virtual_mailbox_maps = texthash:/etc/postfix/vmailbox
virtual_transport = lmtp:unix:private/dovecot-lmtp
alias_maps =
alias_database =
# Default chain: wrong name. SNI selects the right chain (tls_server_sni_maps, Postfix >= 3.4).
smtpd_tls_chain_files = /etc/postfix/pki/wrong.pem
tls_server_sni_maps = lmdb:/etc/postfix/sni
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtp_tls_security_level = none
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_unlisted_recipient, permit_sasl_authenticated, reject
