# Host side of the apache role, sourced by testenv.sh. The dataset is datasets/apache/.cache/maildir
# (built by datasets/apache/build.py, owned by the dataset; one user `apache`, mailbox_list_layout=fs,
# files uid 1000). Dovecot serves .state/apache/work/mail, a hard-link tree of the dataset (`cp -al` on the
# host: no extra disk). This is safe because Dovecot never rewrites a message file in place: flags rename the
# link, expunge unlinks it, and dovecot-uidlist is replaced by rename. Indexes go to work/index, outside the
# tree. The stamp is sha256(datasets/apache/MANIFEST.tsv) (the per-month source pins) plus the builder's
# maildir index digest (.cache/build/maildir-index.sha256), so a rebuilt dataset gives a fresh work copy.
# `testenv.sh reset apache` deletes work/ and the next start links it again.
APACHE_DATASET=$HERE/../datasets/apache

apache_docker_args() {
  local maildir=$APACHE_DATASET/.cache/maildir work=$STATE/apache/work stamp
  [[ -d $maildir && -f $APACHE_DATASET/MANIFEST.tsv && -f $APACHE_DATASET/.cache/build/maildir-index.sha256 ]] ||
    die "apache: datasets/apache/.cache/maildir not built (see datasets/apache/README.md)"
  stamp="$(sha256sum "$APACHE_DATASET/MANIFEST.tsv" | cut -c1-64) $(cut -c1-64 "$APACHE_DATASET/.cache/build/maildir-index.sha256")"
  if [[ ! -d $work/mail || $(cat "$work/STAMP" 2>/dev/null) != "$stamp" || -d $STATE/apache/pristine ]]; then
    # Older layouts (rsync copies owned by container users) and stale links are deleted through the image.
    docker run --rm -v "$STATE/apache:/state" "$IMAGE" rm -rf /state/pristine /state/pristine.tmp /state/work >&2
    mkdir -p "$work"
    cp -al "$maildir" "$work/mail"
    echo "$stamp" > "$work/STAMP"
    echo "apache: work copy hard-linked from $maildir" >&2
  fi
  echo "-e APACHE_STAMP=${stamp// /:}"
}
